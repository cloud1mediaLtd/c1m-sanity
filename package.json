{
  "name": "platform-cms",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "sanity dev --host 127.0.0.1 --port 3333",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "type-check": "tsc --noEmit",
    "lint": "eslint schemaTypes/site.ts schemaTypes/ownership.ts schemaTypes/marketingCopy.ts schemaTypes/validateCopy.ts structure.ts",
    "verify": "pnpm lint && pnpm type-check && pnpm test",
    "migration:plan": "node scripts/plan-migration.mjs",
    "test": "node --test scripts/plan-migration.test.mjs",
    "demo": "node scripts/plan-migration.mjs fixtures/export.ndjson"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/color-input": "^5.0.0",
    "@sanity/vision": "^4.20.3",
    "react": "^19.1",
    "react-dom": "^19.1",
    "sanity": "^4.20.3",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^5.0.2",
    "@types/react": "^19.1",
    "eslint": "^9.28",
    "prettier": "^3.5",
    "typescript": "^5.8"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  },
  "pnpm": {
    "overrides": {
      "glob": ">=10.5.0"
    }
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "24.x"
  }
}
